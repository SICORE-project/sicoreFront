CACHE_STORE=file
QUEUE_CONNECTION=sync

SICORE_API_URL=http://127.0.0.1:8000
SICORE_API_TIMEOUT=10
SICORE_API_CONNECT_TIMEOUT=3
SICORE_TOKEN_LIFETIME=120

# Compte créé par le seeder du backend
SICORE_BOOTSTRAP_EMAIL=admin@sicore.sn
